# Writes OUT: a C++ file holding the redrawn maps (MAPS = .MP files separated by '|', in game order).
string(REPLACE "|" ";" MAPS "${MAPS}")
set(code "// Generated from assets/maps by cmake/embed_maps.cmake. Do not edit.\n#include \"platform/redrawn_maps.hpp\"\n\nnamespace conflict::redrawn_maps {\nnamespace {\n")
set(i 0)
foreach(file IN LISTS MAPS)
  file(READ "${file}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
  string(APPEND code "const uint8_t map${i}[] = {\n${bytes}};\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND code "}  // namespace\n\nstd::span<const uint8_t> map(int index) {\n    switch (index) {\n")
math(EXPR last "${i} - 1")
foreach(k RANGE ${last})
  string(APPEND code "        case ${k}: return map${k};\n")
endforeach()
string(APPEND code "        default: return {};\n    }\n}\n\n}  // namespace conflict::redrawn_maps\n")
file(WRITE "${OUT}" "${code}")
